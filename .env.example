# ==========================================
# DineFlow Environment Configuration Template
# ==========================================
# Note: Copy this file to .env.local for local development.
# Do NOT commit real secrets or credentials to source control.

# Application Environment
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection (Prisma)
# Replace placeholder values with your PostgreSQL connection parameters
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB?schema=public"

# Multi-Tenant & Domain Configuration
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
